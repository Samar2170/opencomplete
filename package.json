{
  "name": "opencomplete",
  "displayName": "OpenComplete",
  "description": "Superfast AI inline autocomplete for VS Code, powered by OpenRouter, OpenAI or Anthropic.",
  "version": "0.3.0",
  "publisher": "samararora99",
  "license": "MIT",
  "repository": "https://github.com/Samar2170/opencomplete",
  "icon": "resources/icon.png",
  "galleryBanner": { "color": "#6366F1", "theme": "dark" },
  "categories": ["Programming Languages", "Machine Learning", "Other"],
  "keywords": ["ai", "autocomplete", "copilot", "openrouter", "openai", "anthropic", "inline completion"],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencomplete.setApiKey",
        "title": "Set API Key",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.pickModel",
        "title": "Pick Model",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.toggle",
        "title": "Toggle Enable / Disable",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.suggestAtCursor",
        "title": "Suggest at Cursor",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.suggestNextEdit",
        "title": "Suggest Next Edit",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.acceptNextWord",
        "title": "Accept Next Word",
        "category": "OpenComplete"
      },
      {
        "command": "opencomplete.benchmark",
        "title": "Benchmark Models",
        "category": "OpenComplete"
      }
    ],
    "keybindings": [
      {
        "command": "opencomplete.suggestAtCursor",
        "key": "alt+\\",
        "when": "editorTextFocus"
      },
      {
        "command": "opencomplete.suggestNextEdit",
        "key": "alt+.",
        "when": "editorTextFocus"
      },
      {
        "command": "opencomplete.acceptNextWord",
        "key": "alt+]",
        "when": "editorTextFocus && inlineSuggestionVisible && config.opencomplete.partialAccept"
      }
    ],
    "configuration": {
      "title": "OpenComplete",
      "properties": {
        "opencomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline completions."
        },
        "opencomplete.provider": {
          "type": "string",
          "enum": ["openrouter", "openai", "anthropic"],
          "enumDescriptions": [
            "OpenRouter (openrouter.ai)",
            "OpenAI (api.openai.com)",
            "Anthropic (api.anthropic.com)"
          ],
          "default": "openrouter",
          "description": "API provider used for completions."
        },
        "opencomplete.model": {
          "type": "string",
          "default": "poolside/laguna-s-2.1:free",
          "description": "Model id. Use the \"OpenComplete: Pick Model\" command to browse available models."
        },
        "opencomplete.promptStyle": {
          "type": "string",
          "enum": ["auto", "chat", "fim"],
          "enumDescriptions": [
            "Use native fill-in-the-middle markers when the model supports them, otherwise chat prompt.",
            "Always use the chat-style prompt.",
            "Always use fill-in-the-middle markers."
          ],
          "default": "auto",
          "description": "Prompt format used for completions."
        },
        "opencomplete.maxTokens": {
          "type": "integer",
          "default": 64,
          "minimum": 16,
          "maximum": 1024,
          "description": "Maximum tokens generated per completion. Lower is faster."
        },
        "opencomplete.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for completions."
        },
        "opencomplete.debounceMs": {
          "type": "integer",
          "default": 150,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before requesting a completion after typing stops."
        },
        "opencomplete.contextLines": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "maximum": 400,
          "description": "How many lines of surrounding context to send."
        },
        "opencomplete.prefetchIdle": {
          "type": "boolean",
          "default": true,
          "description": "Prefetch a completion while the cursor idles at the end of a line."
        },
        "opencomplete.prefetchIdleMs": {
          "type": "integer",
          "default": 600,
          "minimum": 100,
          "maximum": 5000,
          "description": "Idle time before prefetching."
        },
        "opencomplete.partialAccept": {
          "type": "boolean",
          "default": true,
          "description": "Enable word-by-word acceptance with Alt+]."
        },
        "opencomplete.enabledLanguages": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["*"],
          "description": "Language ids completions are enabled for. [\"*\"] enables all languages."
        },
        "opencomplete.relatedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Include up to two open same-language tabs as extra context."
        },
        "opencomplete.relatedFileLines": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "description": "How many lines of each related file to include."
        },
        "opencomplete.nextEdit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Predict edits elsewhere in the file (e.g. rename propagation) and show them as ghost text; Tab applies them."
        },
        "opencomplete.nextEdit.fallback": {
          "type": "boolean",
          "default": false,
          "description": "When a normal completion comes back empty, make a second full-file request to predict a next edit. Adds latency; off by default."
        },
        "opencomplete.nextEdit.debounceMs": {
          "type": "integer",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay before predicting a next edit after typing stops."
        },
        "opencomplete.nextEdit.maxFileChars": {
          "type": "integer",
          "default": 8000,
          "minimum": 2000,
          "maximum": 40000,
          "description": "Maximum file size sent to the next-edit predictor."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  }
}
